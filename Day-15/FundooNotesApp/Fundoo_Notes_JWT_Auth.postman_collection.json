			"name": "01 - Authentication",
			"item": [
				{
					"name": "1. User Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"Aman\",\n  \"lastName\": \"Gola\",\n  \"email\": \"fresher.test@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Registers a new user and returns auto-saved JWT token."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var responseJson = pm.response.json();",
									"    if (responseJson.token) {",
									"        pm.collectionVariables.set(\"jwt_token\", responseJson.token);",
									"        console.log(\"JWT Token Auto-Saved: \" + responseJson.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"response": []
				},
