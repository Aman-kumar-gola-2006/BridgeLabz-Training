{
	"info": {
		"_postman_id": "f8a9b0c1-d2e3-4567-8901-abcdef123456",
		"name": "Fundoo Notes App - Complete Postman Collection",
		"description": "Single official Postman collection for Fundoo Notes App APIs:\n\n1. Authentication (Register, Login, Forgot Password via JMS Async Queue)\n2. Notes Management (Create, Get All Notes, Get By ID, Update, Pin, Archive, Trash, Restore, Delete)\n3. Tags Management (Add Tag, Remove Tag)\n4. Asynchronous JMS Reminders & Search Module",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8083",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "01 - Authentication",
			"item": [
				{
					"name": "1. User Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"Aman\",\n  \"lastName\": \"Gola\",\n  \"email\": \"aman.gola@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Registers a new user and auto-saves JWT token to collection variables."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var responseJson = pm.response.json();",
									"    if (responseJson.token) {",
									"        pm.collectionVariables.set(\"jwt_token\", responseJson.token);",
									"        console.log(\"JWT Token Auto-Saved: \" + responseJson.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"response": []
				},
				{
					"name": "2. User Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
